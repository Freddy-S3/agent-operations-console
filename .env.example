# Copy this file to .env. Never commit .env or paste the token into chat.
ATLASSIAN_EMAIL=your-atlassian-email@example.com
# Use a short-lived classic API token for the direct site REST endpoints used by this prototype.
ATLASSIAN_API_TOKEN=paste-your-short-lived-token-here
JIRA_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_BASE_URL=https://your-site.atlassian.net

# Jira Cloud signs webhook bodies with this secret using X-Hub-Signature.
WEBHOOK_SECRET=generate-a-long-random-secret-here
